{
  "Comment": "Klyro experiment pipeline: build+seed, deploy, load-test, diagnose, patch, rebuild+redeploy, load-test, evaluate, report.",
  "StartAt": "ParallelBaselineBuildAndSeed",
  "States": {
    "ParallelBaselineBuildAndSeed": {
      "Type": "Parallel",
      "ResultPath": null,
      "Branches": [
        {
          "StartAt": "BuildBaselineImage",
          "States": {
            "BuildBaselineImage": {
              "Type": "Task",
              "Resource": "arn:aws:states:::aws-sdk:ssm:sendCommand",
              "Parameters": {
                "DocumentName": "AWS-RunShellScript",
                "InstanceIds": [
                  "${BuilderInstanceId}"
                ],
                "Parameters": {
                  "commands.$": "States.Array(States.Format('RUN_ID={} PHASE=baseline /opt/klyro/build.sh', $.runId))"
                }
              },
              "ResultPath": "$.buildCommand",
              "TimeoutSeconds": 60,
              "Retry": [
                {
                  "ErrorEquals": [
                    "Ssm.TooManyUpdatesException",
                    "Ssm.ThrottlingException",
                    "States.TaskFailed"
                  ],
                  "IntervalSeconds": 2,
                  "MaxAttempts": 3,
                  "BackoffRate": 2.0
                }
              ],
              "Next": "WaitForBaselineCommandRegistration"
            },
            "WaitForBaselineCommandRegistration": {
              "Type": "Wait",
              "Seconds": 10,
              "Next": "InitBaselineBuildPollCount"
            },
            "InitBaselineBuildPollCount": {
              "Type": "Pass",
              "Parameters": {
                "runId.$": "$.runId",
                "commandId.$": "$.buildCommand.Command.CommandId",
                "pollCount": 0
              },
              "Next": "GetBaselineBuildStatus"
            },
            "GetBaselineBuildStatus": {
              "Type": "Task",
              "Resource": "arn:aws:states:::aws-sdk:ssm:getCommandInvocation",
              "Parameters": {
                "CommandId.$": "$.commandId",
                "InstanceId": "${BuilderInstanceId}"
              },
              "ResultPath": "$.buildStatus",
              "TimeoutSeconds": 60,
              "Retry": [
                {
                  "ErrorEquals": [
                    "Ssm.TooManyUpdatesException",
                    "Ssm.ThrottlingException",
                    "States.TaskFailed"
                  ],
                  "IntervalSeconds": 2,
                  "MaxAttempts": 3,
                  "BackoffRate": 2.0
                }
              ],
              "Next": "CheckBaselineBuildStatus"
            },
            "CheckBaselineBuildStatus": {
              "Type": "Choice",
              "Choices": [
                {
                  "Variable": "$.buildStatus.Status",
                  "StringEquals": "Success",
                  "Next": "BaselineBuildSucceeded"
                },
                {
                  "Variable": "$.buildStatus.Status",
                  "StringEquals": "Failed",
                  "Next": "BaselineBuildFailed"
                },
                {
                  "Variable": "$.buildStatus.Status",
                  "StringEquals": "Cancelled",
                  "Next": "BaselineBuildFailed"
                },
                {
                  "Variable": "$.buildStatus.Status",
                  "StringEquals": "TimedOut",
                  "Next": "BaselineBuildFailed"
                },
                {
                  "Variable": "$.buildStatus.Status",
                  "StringEquals": "Undeliverable",
                  "Next": "BaselineBuildFailed"
                },
                {
                  "Variable": "$.buildStatus.Status",
                  "StringEquals": "Terminated",
                  "Next": "BaselineBuildFailed"
                },
                {
                  "Variable": "$.pollCount",
                  "NumericGreaterThanEquals": 40,
                  "Next": "BaselineBuildTimeout"
                }
              ],
              "Default": "WaitBaselineBuildStatus"
            },
            "WaitBaselineBuildStatus": {
              "Type": "Wait",
              "Seconds": 15,
              "Next": "IncrementBaselineBuildPollCount"
            },
            "IncrementBaselineBuildPollCount": {
              "Type": "Pass",
              "Parameters": {
                "runId.$": "$.runId",
                "commandId.$": "$.commandId",
                "pollCount.$": "States.MathAdd($.pollCount, 1)"
              },
              "Next": "GetBaselineBuildStatus"
            },
            "BaselineBuildFailed": {
              "Type": "Fail",
              "Error": "BuildFailed",
              "Cause": "SSM RunCommand for phase=baseline build did not succeed - check the AWS-RunShellScript command output on the klyro-builder instance"
            },
            "BaselineBuildTimeout": {
              "Type": "Fail",
              "Error": "BuildTimeout",
              "Cause": "SSM RunCommand for phase=baseline build did not complete within the polling budget"
            },
            "BaselineBuildSucceeded": {
              "Type": "Succeed"
            }
          }
        },
        {
          "StartAt": "SeedDatabaseBaseline",
          "States": {
            "SeedDatabaseBaseline": {
              "Type": "Task",
              "Resource": "arn:aws:states:::ecs:runTask.sync",
              "Parameters": {
                "Cluster": "${ClusterName}",
                "TaskDefinition": "${DbInitTaskFamily}",
                "LaunchType": "FARGATE",
                "NetworkConfiguration": {
                  "AwsvpcConfiguration": {
                    "Subnets": [
                      "${PublicSubnet1}",
                      "${PublicSubnet2}"
                    ],
                    "SecurityGroups": [
                      "${DbInitSecurityGroupId}"
                    ],
                    "AssignPublicIp": "ENABLED"
                  }
                }
              },
              "TimeoutSeconds": 1800,
              "Retry": [
                {
                  "ErrorEquals": [
                    "ECS.ThrottlingException",
                    "ECS.ServerException",
                    "States.TaskFailed"
                  ],
                  "IntervalSeconds": 5,
                  "MaxAttempts": 2,
                  "BackoffRate": 2.0
                }
              ],
              "End": true
            }
          }
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "MarkFailed"
        }
      ],
      "Next": "DeployBaselineImage"
    },
    "DeployBaselineImage": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${DeployAppFunctionArn}",
        "Payload": {
          "runId.$": "$.runId",
          "phase": "baseline"
        }
      },
      "ResultPath": null,
      "TimeoutSeconds": 120,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "MarkFailed"
        }
      ],
      "Next": "InitBaselinePollCount"
    },
    "InitBaselinePollCount": {
      "Type": "Pass",
      "Parameters": {
        "runId.$": "$.runId",
        "pollCount": 0
      },
      "Next": "DescribeAppServiceBaseline"
    },
    "DescribeAppServiceBaseline": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:ecs:describeServices",
      "Parameters": {
        "Cluster": "${ClusterName}",
        "Services": [
          "${AppServiceName}"
        ]
      },
      "ResultPath": "$.describeResult",
      "TimeoutSeconds": 60,
      "Retry": [
        {
          "ErrorEquals": [
            "ECS.ThrottlingException",
            "ECS.ServerException",
            "States.TaskFailed"
          ],
          "IntervalSeconds": 5,
          "MaxAttempts": 2,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "MarkFailed"
        }
      ],
      "Next": "CheckBaselineRollout"
    },
    "CheckBaselineRollout": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.describeResult.Services[0].Deployments[0].RolloutState",
          "StringEquals": "COMPLETED",
          "Next": "RunK6Baseline"
        },
        {
          "Variable": "$.pollCount",
          "NumericGreaterThanEquals": 20,
          "Next": "SetBaselineRolloutTimeoutError"
        }
      ],
      "Default": "WaitBaselineRollout"
    },
    "WaitBaselineRollout": {
      "Type": "Wait",
      "Seconds": 15,
      "Next": "IncrementBaselinePollCount"
    },
    "IncrementBaselinePollCount": {
      "Type": "Pass",
      "Parameters": {
        "runId.$": "$.runId",
        "pollCount.$": "States.MathAdd($.pollCount, 1)"
      },
      "Next": "DescribeAppServiceBaseline"
    },
    "SetBaselineRolloutTimeoutError": {
      "Type": "Pass",
      "Parameters": {
        "runId.$": "$.runId",
        "error": {
          "Error": "RolloutTimeout",
          "Cause": "App service rollout for phase=baseline did not reach RolloutState=COMPLETED within the polling budget"
        }
      },
      "Next": "MarkFailed"
    },
    "RunK6Baseline": {
      "Type": "Task",
      "Resource": "arn:aws:states:::ecs:runTask.sync",
      "Parameters": {
        "Cluster": "${ClusterName}",
        "TaskDefinition": "${K6TaskFamily}",
        "LaunchType": "FARGATE",
        "NetworkConfiguration": {
