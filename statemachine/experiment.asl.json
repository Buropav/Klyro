    "BuildOptimizedImage": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:ssm:sendCommand",
      "Parameters": {
        "DocumentName": "AWS-RunShellScript",
        "InstanceIds": [
          "${BuilderInstanceId}"
        ],
        "Parameters": {
          "commands.$": "States.Array(States.Format('RUN_ID={} PHASE=optimized /opt/klyro/build.sh', $.runId))"
        }
      },
      "ResultPath": "$.buildCommand",
      "TimeoutSeconds": 60,
      "Retry": [
        {
          "ErrorEquals": [
            "Ssm.TooManyUpdatesException",
            "Ssm.ThrottlingException",
            "States.TaskFailed"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "MarkFailed"
        }
      ],
      "Next": "WaitForOptimizedCommandRegistration"
    },
    "WaitForOptimizedCommandRegistration": {
      "Type": "Wait",
      "Seconds": 10,
      "Next": "InitOptimizedBuildPollCount"
    },
    "InitOptimizedBuildPollCount": {
      "Type": "Pass",
      "Parameters": {
        "runId.$": "$.runId",
        "commandId.$": "$.buildCommand.Command.CommandId",
