            "Subnets": [
              "${PublicSubnet1}",
              "${PublicSubnet2}"
            ],
            "SecurityGroups": [
              "${K6SecurityGroupId}"
            ],
            "AssignPublicIp": "ENABLED"
          }
        },
        "Overrides": {
          "ContainerOverrides": [
            {
              "Name": "k6",
              "Environment": [
                {
                  "Name": "RUN_ID",
                  "Value.$": "$.runId"
                },
                {
                  "Name": "PHASE",
                  "Value": "baseline"
                },
                {
                  "Name": "TARGET_URL",
                  "Value": "${AppTargetUrl}"
                }
              ]
            }
          ]
        }
      },
      "ResultPath": "$.k6Baseline",
      "TimeoutSeconds": 1800,
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "MarkFailed"
        }
      ],
      "Next": "CompactBaselineMetrics"
    },
    "CompactBaselineMetrics": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${MetricsCompactorFunctionArn}",
        "Payload": {
          "runId.$": "$.runId",
          "phase": "baseline",
          "startTime.$": "$.k6Baseline.Tasks[0].StartedAt",
          "endTime.$": "$.k6Baseline.Tasks[0].StoppedAt"
        }
      },
      "ResultPath": null,
      "TimeoutSeconds": 120,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "MarkFailed"
        }
      ],
      "Next": "RunAnalyst"
    },
    "RunAnalyst": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${AnalystFunctionArn}",
        "Payload": {
          "runId.$": "$.runId",
